<?xml version="1.0"?>
<package format="3">
  <name>v4l2_ros2_adapter</name>
  <version>0.3.0</version>
  <description>ROS 2 Image, CameraInfo, and diagnostics adapter for the v4l2_capture TCP frame protocol.</description>

  <maintainer email="maintainer@example.com">v4l2_capture maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
